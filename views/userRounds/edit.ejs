<%- include("../partials/header") %>
<div class="container">

<%
  var numRound = round.numRound;
  // Format a score: trim trailing zeros, prefix + for positives
  function fmtPts(n) {
    var v = parseFloat(n.toFixed(2));
    return (v >= 0 ? '+' : '') + v;
  }
%>
<h1 style="text-align: left;">
    <% if (numRound < 7) { %>
        <% if (targetFirstName) { %><%= targetFirstName %>'s <% } %>Round <%= numRound %> Picks:
    <% } else if (numRound === 7) { %>
        <% if (targetFirstName) { %><%= targetFirstName %>'s <% } %>Final Four Picks:
    <% } else {%>
        <% if (targetFirstName) { %><%= targetFirstName %>'s <% } %>Champion Pick:
    <% } %>
</h1>

<% if (numRound === 1) { %>
<div class="pick-stepper">
    <div class="pick-step active">
        <div class="pick-step-dot">1</div>
        <span>Round 1</span>
    </div>
    <div class="pick-step-line"></div>
    <div class="pick-step">
        <div class="pick-step-dot">2</div>
        <span>Final Four</span>
    </div>
    <div class="pick-step-line"></div>
    <div class="pick-step">
        <div class="pick-step-dot">3</div>
        <span>Champion</span>
    </div>
</div>
<% } %>

<p class="scoring-note"><i class="fas fa-info-circle"></i> Points shown as +win / -loss for picking each team. <a href="/rules">How scoring works</a></p>

<!--=======================================================-->
<!--UPDATE FORM ACTION AND LOCATION-->
<!--=======================================================-->
<!--<div class="container">-->
    <div class="row">
        <form class="teamPicker" action="/tournamentGroups/<%= tournamentGroup.groupName %>/userTournaments/<%= username %>/<%=numRound%>?_method=PUT" method="POST">
            
            <% for(var j = 0; j < tournament.rounds[numRound - 1].matches.length; j++) { %>
                <% var quarterNumMatches = tournament.rounds[numRound-1].matches.length / 4 %>
                
                <% if(numRound < 5 && j % quarterNumMatches === 0 ) { %>
                    <div class="regionPicker col-xs-12 col-sm-6 col-md-3 ">
                        <h2 class="regionLabel"><%=tournament.regions[Math.floor(j / quarterNumMatches)]%></h2>
                <% } else if (numRound === 5 || numRound === 6) { %>
                    <div class="regionPicker col-xs-12 col-sm-6 col-md-3 ">
                <% } %>
                    
                    <% var match = tournament.rounds[numRound - 1].matches[j]; %>
                    <% if (match.topTeam && match.bottomTeam) { %>
                        <% var scores = calculateScores(match.topTeam.seed, match.bottomTeam.seed, numRound) %>
                        <%
                            var isFinished = !!match.winner;
                            var losingTeamId = '';
                            if (isFinished) {
                                losingTeamId = match.winner._id.equals(match.topTeam._id)
                                    ? match.bottomTeam._id.toString()
                                    : match.topTeam._id.toString();
                            }
                        %>

                        <div class="form-group matchPicker<% if (isFinished) { %> match-finished<% } %>">
                            <% if (isFinished) { %><div class="match-complete-label"><i class="fas fa-check-circle"></i> Game Complete</div><% } %>
                            <% var matchNum = match.matchNumber %>
                            <% var idMaker = tournament.year + "m" + match.matchNumber %>

                            <label for="<%=idMaker%>top" style="display: block">
                                <div class="team" >
                                    <input class="radio" type="radio" id="<%=idMaker%>top" name="<%=matchNum%>" value="<%= match.topTeam._id %>" required
                                        <% if (isFinished && losingTeamId === match.topTeam._id.toString()) { %>checked<% } %>>
                                    <div class="teamTitle">
                                        <img class="pickerImage" src="<%= match.topTeam.image %>">
                                        <span class="seed"><%=match.topTeam.seed%></span>
                                        <span class="teamName"><%=match.topTeam.name.replace("State","St.")%></span>
                                        <span class="pick-scores"><%=fmtPts(scores.topWinScore)%> / <%=fmtPts(scores.topLossScore)%></span>
                                    </div>
                                </div>
                            </label>

                            <label for="<%=idMaker%>bottom" style="display: block">
                                <div class="team">
                                    <input class="radio" type="radio" id="<%=idMaker%>bottom" name="<%=matchNum%>" value="<%= match.bottomTeam._id %>"
                                        <% if (isFinished && losingTeamId === match.bottomTeam._id.toString()) { %>checked<% } %>>
                                    <div class="teamTitle">
                                        <img class="pickerImage"  src="<%= match.bottomTeam.image %>">
                                        <span class="seed"><%=match.bottomTeam.seed%></span>
                                        <span class="teamName"><%=match.bottomTeam.name.replace("State","St.")%></span>
                                        <span class="pick-scores"><%=fmtPts(scores.bottomWinScore)%> / <%=fmtPts(scores.bottomLossScore)%></span>
                                    </div>
                                </div>
                            </label>

                            <div class="form-group">
                                <input class="form-control" type="text" name="<%=matchNum%>" placeholder="Optional comment">
                            </div>

                        </div>
                    <% } %>    
                
               
               <% if(numRound < 5 && j % quarterNumMatches ===  quarterNumMatches - 1) { %>
                    </div>
                <% } else if (numRound === 5 || numRound === 6) { %>
                    </div>
                <% } %>
               
               
            <% } %>
            <div class="form-group">
                <% if (numRound === 1) { %>
                <button class="btn btn-primary btn-lg btn-default btn-block">Submit & Pick Final Four <i class="fas fa-arrow-right"></i></button>
                <% } else { %>
                <button class="btn btn-primary btn-lg btn-default btn-block">Submit</button>
                <% } %>
            </div>
        </form>
    </div>
<!--</div>-->

</div>
<%- include("../partials/footer") %>