<% include ../partials/header %>

<h1 style="text-align: left;">
    <% if (numRound < 7) { %>
        <% if (targetFirstName) { %><%= targetFirstName %>'s <% } %>Round <%= numRound %> Picks:
    <% } else if (numRound === 7) { %>
        <% if (targetFirstName) { %><%= targetFirstName %>'s <% } %>Final Four Picks:
    <% } else {%>
        <% if (targetFirstName) { %><%= targetFirstName %>'s <% } %>Champion Pick:
    <% } %>
</h1>

<!--=======================================================-->
<!--UPDATE FORM ACTION AND LOCATION-->
<!--=======================================================-->

<div class="pick-stepper">
    <div class="pick-step completed">
        <div class="pick-step-dot"><i class="fas fa-check"></i></div>
        <span>Round 1</span>
    </div>
    <div class="pick-step-line completed"></div>
    <div class="pick-step active">
        <div class="pick-step-dot">2</div>
        <span>Final Four</span>
    </div>
    <div class="pick-step-line"></div>
    <div class="pick-step">
        <div class="pick-step-dot">3</div>
        <span>Champion</span>
    </div>
</div>

<p class="scoring-note"><i class="fas fa-info-circle"></i> 5 points for each correct Final Four pick, 0 for incorrect</p>

<form action="/tournamentGroups/<%= tournamentGroup.groupName %>/userTournaments/<%= username %>/<%=numRound%>?_method=PUT" method="POST">
    <% for(var i = 0; i < 4; i++) { %>
        <div class="form-group column">
            <label for="finalFourPicks"><%=tournament.rounds[0].matches[i * 8].topTeam.region%></label>
            <select id="finalFourPicks" name="<%=57 + i%>">
                <% for(var j = 0; j < 8; j++) { %>
                    <% var match = tournament.rounds[0].matches[i*8 + j] %>
                    <option value="<%=match.topTeam._id%>"><%=match.topTeam.seed%>) <%=match.topTeam.name%></option>
                    <option value="<%=match.bottomTeam._id%>"><%=match.bottomTeam.seed%>) <%=match.bottomTeam.name%></option>
                <% } %>
            </select>
        </div>
        <div class="form-group">
            <input class="form-control" type="text" name="<%=57 + i%>" placeholder="Optional comment">
        </div>
    <% } %>
    
       
    <div class="form-group">
        <button class="btn btn-primary btn-lg btn-default btn-block">Submit & Pick Champion <i class="fas fa-arrow-right"></i></button>
    </div>
</form>

<% include ../partials/footer %>