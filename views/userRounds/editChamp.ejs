<%- include("../partials/header") %>
<div class="container">

<h1 style="text-align: left;">
    <% if (numRound < 7) { %>
        <% if (targetFirstName) { %><%= targetFirstName %>'s <% } %>Round <%= numRound %> Picks:
    <% } else if (numRound === 7) { %>
        <% if (targetFirstName) { %><%= targetFirstName %>'s <% } %>Final Four Picks:
    <% } else {%>
        <% if (targetFirstName) { %><%= targetFirstName %>'s <% } %>Champion Pick:
    <% } %>
</h1>

<div class="pick-stepper">
    <div class="pick-step completed">
        <div class="pick-step-dot"><i class="fas fa-check"></i></div>
        <span>Round 1</span>
    </div>
    <div class="pick-step-line completed"></div>
    <div class="pick-step completed">
        <div class="pick-step-dot"><i class="fas fa-check"></i></div>
        <span>Final Four</span>
    </div>
    <div class="pick-step-line completed"></div>
    <div class="pick-step active">
        <div class="pick-step-dot">3</div>
        <span>Champion</span>
    </div>
</div>

<p class="scoring-note"><i class="fas fa-info-circle"></i> 10 points for correct Championship pick, 0 for incorrect</p>

<% if (typeof bonusPicksAreLate !== 'undefined' && bonusPicksAreLate) { %>
<div class="alert alert-warning" style="margin-bottom: 16px;">
    <i class="fas fa-exclamation-triangle"></i> <strong>Late submission:</strong> Round 1 has already tipped off. Your Championship pick will be submitted for commissioner review. The commissioner will decide whether to accept it.
</div>
<% } %>

<% if (isDev) { %>
<div class="text-center" style="margin-bottom: 12px;">
    <button type="button" id="randomFillBtn" class="btn btn-warning"><i class="fas fa-random"></i> Choose Random</button>
</div>
<% } %>

<form class="teamPicker" action="/tournamentGroups/<%= tournamentGroup.groupName %>/userTournaments/<%= username %>/<%=numRound%>?_method=PUT" method="POST">

    <% if (finalFourTeams && finalFourTeams.length > 0) { %>
        <div class="regionPicker col-xs-12 champPicker">
            <div class="form-group matchPicker">
                <% for(var i = 0; i < finalFourTeams.length; i++) { %>
                    <% var team = finalFourTeams[i] %>
                    <% var idMaker = "champ" + i %>

                    <label for="<%=idMaker%>" style="display: block">
                        <div class="team">
                            <input class="radio" type="radio" id="<%=idMaker%>" name="63" value="<%= team._id %>" <%= i === 0 ? 'required' : '' %>>
                            <div class="teamTitle">
                                <img class="pickerImage" src="<%= team.image %>">
                                <span class="seed"><%=team.seed%></span>
                                <span class="teamName"><%=team.name%></span>
                            </div>
                        </div>
                    </label>
                <% } %>
            </div>
        </div>
    <% } else { %>
        <!-- Fallback: if Final Four picks weren't found, show all teams in a dropdown -->
        <div class="form-group column">
            <select id="championPick" name="63">
                <% for(var j = 0; j < 32; j++) { %>
                    <% var match = tournament.rounds[0].matches[j] %>
                    <option value="<%=match.topTeam._id%>"><%=match.topTeam.seed%>) <%=match.topTeam.name%></option>
                    <option value="<%=match.bottomTeam._id%>"><%=match.bottomTeam.seed%>) <%=match.bottomTeam.name%></option>
                <% } %>
            </select>
        </div>
    <% } %>

    <div class="form-group">
        <input class="form-control" type="text" name="63" placeholder="Optional comment">
    </div>

    <div class="form-group">
        <button class="btn btn-primary btn-lg btn-default btn-block">Submit Picks <i class="fas fa-check"></i></button>
    </div>
</form>

<script>
var randomBtn = document.getElementById('randomFillBtn');
if (randomBtn) {
  randomBtn.addEventListener('click', function() {
    var radios = document.querySelectorAll('.teamPicker input[type="radio"]');
    if (radios.length > 0) {
      radios[Math.floor(Math.random() * radios.length)].checked = true;
    }
  });
}
</script>

</div>
<%- include("../partials/footer") %>