<% include ./partials/header %>
<div class="container">

<div class="row">
    <h1 style="text-align: center"><i class="fas fa-sign-in-alt"></i> Login</h1>
    <div class="login-form">
        <form action="/login" method="POST">
            <div class="form-group">
                <input class="form-control" type="text" name="username" placeholder="username">
            </div>
            <div class="form-group">
                <input class="form-control" type="password" name="password" placeholder="password">
            </div>
            <div class="form-group">
                <button class="btn btn-lg btn-primary btn-block">Login</button>
            </div>
        </form>
    </div>
    <a href='/forgotUsername' class="btn btn-link">Forgot Username?</a>
    <a href='/forgotPassword' class="btn btn-link">Forgot Password?</a>
    <p class="text-center" style="margin-top: 20px; color: #666;">
        Don't have an account? <a href="/register" style="font-weight: 600;">Sign up now!</a>
    </p>
</div>

</div>
<% include ./partials/footer %>