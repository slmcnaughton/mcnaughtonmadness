<%- include("../partials/header") %>
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.10.16/css/jquery.dataTables.css">
<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.10.16/js/jquery.dataTables.js"></script>
<div class="container">

            <div class="jumbotron hero">
                <p class="intro" id="intro">McNaughton</p>
                <h1 id="headline">Madness</h1>
                <p class="year"><span class="icomoon icon-bracketLeft"></span>
                    <%=tournamentGroup.tournamentReference.year%><span class="icomoon icon-bracketRight"></span>
                </p>
                <p>
                    <%=tournamentGroup.groupName%>
                </p>
            </div>

            <div class="navbar navbar-inverse navbar-fixed-left">
                <ul class="nav navbar-nav">
                    <li><a href="/tournamentGroups/<%= tournamentGroup.groupName%>"><i class="fas fa-table"></i>
                            Standings</a></li>
                    <li><a href="/tournamentGroups/<%= tournamentGroup.groupName%>/bracket"><i
                                class="fas fa-trophy"></i> Group Bracket</a></li>
                    <li><a href="/tournamentGroups/<%= tournamentGroup.groupName%>/messageboard"><i
                                class="fas fa-comments"></i> Message Board</a></li>
                </ul>
            </div>

            <div class="container">
                <div class="row">

                    <div class="joinOrPick standingsInfo col-xs-12 col-sm-4">
                        <% if(!isInGroup) { %>
                            <form action="/tournamentGroups/<%= tournamentGroup.groupName%>/userTournaments"
                                method="POST">
                                <% if(tournamentGroup.publicGroup===false) { %>
                                    <div class="form-group col-xs-12">
                                        <label for="secretCode">Enter your group's secret code below:</label>
                                        <input type="text" id="secretCode" name="secretCode" class="form-control">
                                    </div>
                                    <% } %>
                                        <div class="form-group text-center">
                                            <button class="btn btn-success btn-lg btn-default">Join Group</button>
                                        </div>
                            </form>
                            <% } else if (picksNeeded) { %>
                                <div class="text-center">
                                    <a class="btn btn-success btn-lg btn-default"
                                        href="/tournamentGroups/<%= tournamentGroup.groupName%>/userTournaments/<%=currentUser.username%>/<%=tournamentGroup.currentRound%>/edit">
                                        <% if (typeof hasDraft !== 'undefined' && hasDraft) { %>
                                            Edit Draft / Submit Round <%=tournamentGroup.currentRound%> Picks
                                        <% } else if (typeof hasLockedPicks !== 'undefined' && hasLockedPicks) { %>
                                            Complete & Submit Round <%=tournamentGroup.currentRound%> Picks
                                        <% } else { %>
                                            Make Round <%=tournamentGroup.currentRound%> Picks!
                                        <% } %>
                                    </a>
                                    <% if (typeof hasDraft !== 'undefined' && hasDraft && draftUpdatedAt) { %>
                                        <div class="draft-status draft-status-success" style="margin-top: 8px; display: inline-block;">
                                            <i class="fas fa-save"></i> Draft saved: <%= moment(draftUpdatedAt).tz("America/New_York").format('MMM D, h:mm A') %> ET
                                        </div>
                                    <% } else if (typeof hasLockedPicks !== 'undefined' && hasLockedPicks) { %>
                                        <div style="margin-top: 6px; font-size: 0.85em; color: #8e6fbf;">
                                            <i class="fas fa-lock"></i> <%= lockedPickCount %> pick(s) locked from your draft — complete the rest and submit
                                        </div>
                                    <% } %>
                                </div>
                                <% } else if (finalFourPicksNeeded) { %>
                                    <div class="text-center">
                                        <a class="btn btn-success btn-lg btn-default"
                                            href="/tournamentGroups/<%= tournamentGroup.groupName%>/userTournaments/<%=currentUser.username%>/7/edit">
                                            Make Final Four Picks!
                                        </a>
                                    </div>
                                    <% } else if (championshipPicksNeeded) { %>
                                        <div class="text-center">
                                            <a class="btn btn-success btn-lg btn-default"
                                                href="/tournamentGroups/<%= tournamentGroup.groupName%>/userTournaments/<%=currentUser.username%>/8/edit">
                                                Make Championship Pick!
                                            </a>
                                        </div>
                                        <% } else { %>
                                            <h4>Picks made. Go cheer on your teams!</h4>
                                            <% if (typeof hasPendingBonusPicks !== 'undefined' && hasPendingBonusPicks) { %>
                                                <div class="alert alert-warning" style="margin-top: 8px; text-align: left;">
                                                    <i class="fas fa-clock"></i> Your <strong><%= pendingBonusRounds.join(" & ") %></strong> pick(s) are pending commissioner approval.
                                                </div>
                                            <% } %>
                                            <% if (typeof hasRejectedBonusPicks !== 'undefined' && hasRejectedBonusPicks) { %>
                                                <div class="alert alert-danger" style="margin-top: 8px; text-align: left;">
                                                    <i class="fas fa-times-circle"></i> Your late bonus picks were not accepted by the commissioner. They are visible but scored as 0.
                                                </div>
                                            <% } %>
                                            <% if (typeof nextRoundAvailable !== 'undefined' && nextRoundAvailable) { %>
                                                <div class="text-center" style="margin-top: 12px;">
                                                    <a class="btn btn-info btn-lg btn-default"
                                                        href="/tournamentGroups/<%= tournamentGroup.groupName%>/userTournaments/<%=currentUser.username%>/<%=nextRoundNum%>/edit">
                                                        <% if (typeof hasNextRoundDraft !== 'undefined' && hasNextRoundDraft) { %>
                                                            <i class="fas fa-edit"></i> Continue Round <%=nextRoundNum%> Draft
                                                        <% } else { %>
                                                            <i class="fas fa-forward"></i> Start Round <%=nextRoundNum%> Draft
                                                        <% } %>
                                                    </a>
                                                    <div style="margin-top: 6px; font-size: 0.85em; color: #666;">
                                                        <%=nextRoundKnownMatchups%> of <%=nextRoundTotalMatchups%> matchups known
                                                    </div>
                                                    <% if (typeof hasNextRoundDraft !== 'undefined' && hasNextRoundDraft && nextRoundDraftUpdatedAt) { %>
                                                        <div class="draft-status draft-status-success" style="margin-top: 6px; display: inline-block;">
                                                            <i class="fas fa-save"></i> Draft saved: <%= moment(nextRoundDraftUpdatedAt).tz("America/New_York").format('MMM D, h:mm A') %> ET
                                                        </div>
                                                    <% } %>
                                                </div>
                                            <% } %>
                                            <% } %>

                    </div>
                    <div class="standingsInfo col-xs-12 col-sm-3">
                        <h4>
                            <%=tournamentGroup.tournamentReference.year%> Tournament
                        </h4>
                        <h5>Commissioner: <%=tournamentGroup.commissioner.name%></h5>
                        <% if(currentUser && (currentUser.isAdmin || (tournamentGroup.commissioner.id && currentUser._id.equals(tournamentGroup.commissioner.id)))) { %>
                          <a href="/tournamentGroups/<%= tournamentGroup.groupName %>/manage" class="btn btn-xs btn-default">
                            <i class="fas fa-cog"></i> Manage Group
                          </a>
                        <% } %>
                        <p><em>
                                <%=tournamentGroup.groupMotto%>
                            </em></p>
                    </div>
                    <div class="standingsInfo roundStartTimes col-xs-12 col-sm-5">
                        <h4>Round Tip Off Times:</h4>
                        <%
                            var now = moment();
                            var foundNext = false;
                        %>
                        <% for (var i=0; i < tournamentGroup.tournamentReference.id.rounds.length; i++) { %>
                            <%
                                var roundMoment = moment(tournamentGroup.tournamentReference.id.rounds[i].startTime);
                                var roundDateTime = roundMoment.tz("America/New_York").format('LLLL') + ' ET';
                                var isPast = roundMoment.isBefore(now);
                                var isNext = !isPast && !foundNext;
                                if (isNext) foundNext = true;
                            %>

                                <h6 class="<%= isPast ? 'round-past' : '' %> <%= isNext ? 'round-next' : '' %>">
                                    <% if (isNext) { %><i class="fas fa-arrow-right" style="font-size: 0.85em;"></i> <% } %>
                                    Round <%=i + 1 %>: <%=roundDateTime%>
                                </h6>
                                <% } %>
                    </div>
                </div>

                <!-- Countdown Timer -->
                <%
                    // Find the next upcoming round startTime (computed server-side, passed via data attribute)
                    var countdownRoundTime = null;
                    var countdownRoundNum = 0;
                    if (tournamentGroup.tournamentReference && tournamentGroup.tournamentReference.id && tournamentGroup.tournamentReference.id.rounds) {
                        for (var ri = 0; ri < tournamentGroup.tournamentReference.id.rounds.length; ri++) {
                            var rnd = tournamentGroup.tournamentReference.id.rounds[ri];
                            if (rnd.startTime && moment(rnd.startTime).isAfter(moment())) {
                                countdownRoundTime = rnd.startTime;
                                countdownRoundNum = ri + 1;
                                break;
                            }
                        }
                    }
                %>
                <div id="groupCountdownBanner" class="countdown-timer" style="display:none;"
                    <% if (countdownRoundTime) { %>
                        data-target-time="<%= new Date(countdownRoundTime).toISOString() %>"
                        data-round-num="<%= countdownRoundNum %>"
                    <% } %>
                ></div>

            </div>

                <h2><i class="fas fa-list-ol"></i> Group Standings:</h2>
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover table-condensed"
                        id="tournamentStandings">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Total</th>
                                <th>Name</th>
                                <th>R1</th>
                                <th>R2</th>
                                <th>R3</th>
                                <th>R4</th>
                                <th>R5</th>
                                <th>R6</th>
                                <th>FF</th>
                                <th>Champ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% var tieCount=0 %>
                                <% var rank=0 %>
                                <% var totalPlayers=tournamentGroup.userTournaments.length %>
                                <% var topHalf=Math.ceil(totalPlayers / 2) %>

                                    <% for(var i=0; i < totalPlayers; i++) { %>

                                        <% var participant=tournamentGroup.userTournaments[i]; %>
                                            <% if (i> 0 && participant.score ===
                                                tournamentGroup.userTournaments[i-1].score) { %>
                                                <% tieCount++ %>
                                                    <% } else { %>
                                                        <% rank +=(1 + tieCount) %>
                                                            <% tieCount=0 %>
                                                                <% } %>


                                                                    <tr class="<%= rank === 1 ? 'tier-gold' : rank === 2 ? 'tier-silver' : rank === 3 ? 'tier-bronze' : rank <= 10 ? 'tier-top10' : rank <= topHalf ? 'tier-top50' : '' %>">
                                                                        <td>
                                                                            <%= rank %>
                                                                        </td>

                                                                        <% var score=participant.score %>
                                                                            <% var
                                                                                rounded=Math.round(score*Math.pow(10,3))/Math.pow(10,3)
                                                                                %>
                                                                                <td>
                                                                                    <%= rounded %>
                                                                                </td>

                                                                                <td><a
                                                                                        href="/tournamentGroups/<%= tournamentGroup.groupName %>/userTournaments/<%= participant.user.username %>">
                                                                                        <%=participant.user.firstName%><%= participant.user.lastName ? ' ' + participant.user.lastName : '' %>
                                                                                </td>

                                                                                <!--Loop through all 8 potential rounds-->
                                                                                <% for(var j=1; j < 9; j++) { %>
                                                                                    <% var found=false %>
                                                                                        <% for(var k=0; k <
                                                                                            participant.userRounds.length;
                                                                                            k++) { %>
                                                                                            <% if(participant.userRounds[k].round.numRound===j)
                                                                                                { %>
                                                                                                <% var
                                                                                                    score=participant.userRounds[k].roundScore
                                                                                                    %>
                                                                                                    <% var
                                                                                                        rounded=Math.round(score*Math.pow(10,3))/Math.pow(10,3)
                                                                                                        %>
                                                                                                        <td>
                                                                                                            <%= rounded
                                                                                                                %>
                                                                                                        </td>
                                                                                                        <% found=true %>
                                                                                                            <% } %>
                                                                                                                <% } %>
                                                                                                                    <% if(found===false
                                                                                                                        )
                                                                                                                        {
                                                                                                                        %>
                                                                                                                        <td>0
                                                                                                                        </td>
                                                                                                                        <% }
                                                                                                                            %>
                                                                                                                            <% }
                                                                                                                                %>
                                                                    </tr>
                                                                    <% } %>
                        </tbody>
                    </table>
                </div>

            <script>
                $(document).ready(function () {
                    $('#tournamentStandings').DataTable({
                        "pageLength": 50
                    });
                });

                // Countdown Timer for next round
                (function() {
                    var banner = document.getElementById('groupCountdownBanner');
                    if (!banner || !banner.dataset.targetTime) return;

                    var targetTime = new Date(banner.dataset.targetTime).getTime();
                    var roundNum = parseInt(banner.dataset.roundNum, 10);

                    function updateGroupCountdown() {
                        var now = Date.now();
                        var diff = targetTime - now;
                        if (diff <= 0 || diff > 3600000) {
                            banner.style.display = 'none';
                            if (diff <= 0) clearInterval(groupCountdownInterval);
                            return;
                        }
                        banner.style.display = 'block';
                        var mins = Math.floor((diff % 3600000) / 60000);
                        var secs = Math.floor((diff % 60000) / 1000);
                        var timeStr = mins + ':' + (secs < 10 ? '0' : '') + secs;
                        if (diff <= 300000) {
                            banner.className = 'countdown-timer countdown-urgent';
                        } else if (diff <= 900000) {
                            banner.className = 'countdown-timer countdown-warning';
                        } else {
                            banner.className = 'countdown-timer countdown-normal';
                        }
                        banner.innerHTML = '<i class="fas fa-clock"></i> Round ' + roundNum + ' tips off in ' + timeStr;
                    }
                    updateGroupCountdown();
                    var groupCountdownInterval = setInterval(updateGroupCountdown, 1000);
                })();
            </script>

</div>
<%- include("../partials/footer") %>