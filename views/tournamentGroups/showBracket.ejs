<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>McNaughton Madness</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">
        <link href='https://fonts.googleapis.com/css?family=Holtwood+One+SC' rel='stylesheet' type='text/css'>
        <link href='https://fonts.googleapis.com/css?family=Abel' rel='stylesheet' type='text/css'>
        <link rel="stylesheet" href="/stylesheets/main.css">
        <script defer src="https://use.fontawesome.com/releases/v5.15.4/js/all.js"></script>
        <script
            src="https://code.jquery.com/jquery-3.3.1.min.js"
            integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8="
            crossorigin="anonymous"></script>
        <script type="text/javascript" src="/js/nhpup_1.1.js"></script>
        
<% include ../partials/navBar %>

<% var tournament = tournamentGroup.tournamentReference.id %>
<%
  // Helper to get the rank for a picker, trying ID first then falling back to name
  function pickerRank(picker) {
    return rankMap[String(picker.id)] || rankByName[picker.firstName] || null;
  }
%>

<main id="tournament">
    <div class="navbar navbar-inverse navbar-center">
        <ul class="nav navbar-nav">
            <li><a href="/tournamentGroups/<%= tournamentGroup.groupName%>"><i class="fas fa-table"></i> Standings</a></li>
            <li><a href="/tournamentGroups/<%= tournamentGroup.groupName%>/bracket"><i class="fas fa-trophy"></i> Group Bracket</a></li>
            <li><a href="/tournamentGroups/<%= tournamentGroup.groupName%>/messageboard"><i class="fas fa-comments"></i> Message Board</a></li>
        </ul>
    </div>
    <div class="jumbotron hero">
        <p class="intro" id="intro">McNaughton</p>
        <h1 id="headline">Madness</h1>
        <p class="year"><span class="icomoon icon-bracketLeft"></span><%=tournamentGroup.tournamentReference.year%><span class="icomoon icon-bracketRight"></span></p>
        <p><%=tournamentGroup.groupName%></p>
    </div>
    
    <div class="container-fluid tournamentContents" style="padding-bottom: 50px; min-height: 300px">
        <div class="row">
            <div class="col-xs-12 bracket"> 
            
                <!--=========================-->
                <!--      FOUR QUADRANTS     -->
                <!--=========================-->
                <% for (quadNum = 0; quadNum < 4; quadNum++) { %>
                    <% if (quadNum === 0) { %>
                        <div class="bracketContents leftSide">
                    <% } else if (quadNum === 2) { %>
                        <div class="bracketContents rightSide">
                    <% } %>
                    
                            <% if (quadNum % 2 === 0) { %>
                                <div class="bracketQuadrant bracketRegion topRegion">
                            <% } else { %>
                                <div class="bracketQuadrant bracketRegion bottomRegion">
                            <% } %>
                                    <h2 class="regionLocation"><%=tournament.regions[quadNum]%></h2>
                                    <div>
                                        <div class="regionRounds">
                                            <!--5 rounds per region-->
                                            <% for(var i = 0; i < tournament.rounds.length-1; i++) { %>
                                                <div class="oneRound">
                                                    <!--number of matches vary per round: we only want 1/4 of all matches in the round in this quadrant-->
                                                    <% var quarterNumMatches = tournament.rounds[i].matches.length / 4 %>
                                                    <% for(var j = 0; j < quarterNumMatches; j++) { %>
                                                        <% var match = tournament.rounds[i].matches[Math.floor(quadNum * quarterNumMatches) + j] %>
                                                        <div class="match" id="match<%= match.matchNumber%>" onmouseover="nhpup.popup($('#matchAggregate<%= match.matchNumber %>').html());">
                                                            <% if (i < tournament.rounds.length - 2 || quadNum % 2 === 0) { %>
                                                                <div class="team">
                                                                    <div class="teamTitle">
                                                                        <% if(match.topTeam !== null) { %>
                                                                            <img src="<%= match.topTeam.image %>">
                                                                            <span class="seed"><%=match.topTeam.seed%></span>
                                                                            
                                                                            
                                                                            <span class="teamName"><%=match.topTeam.name.replace("State","St.")%></span>
                                                                         <% } else { %>
                                                                            &nbsp
                                                                        <% } %>
                                                                    </div>
                                                                    <!--end team title-->
                                                                </div>
                                                                <!--end top team-->
                                                            <% } %>
                                                            
                                                            
                                                            
                                                            <% if (i < tournament.rounds.length - 2 || quadNum % 2 === 1) { %>
                                                                <div class="team">
                                                                    <div class="teamTitle">
                                                                        <% if(match.bottomTeam !== null) { %>
                                                                            <img src="<%= match.bottomTeam.image %>">
                                                                            <span class="seed"><%=match.bottomTeam.seed%></span>
                                                                            <span class="teamName"><%=match.bottomTeam.name.replace("State","St.")%></span>
                                                                        <% } else { %>
                                                                            &nbsp
                                                                        <% } %>
                                                                    </div>
                                                                    <!--end team title-->
                                                                </div>
                                                                <!--end bottom team-->
                                                            <% } %>
                                                            
                                                        </div>
                                                        <!--end match-->
                                                        
                                                        <div class="aggregateBox" id="matchAggregate<%= match.matchNumber %>" style="display: none;">
                                                            <!--things get screwy here if all participants go a round without picking...but I guess if an entire group forgets to pick, no one cares enough-->
                                                            <% if(tournamentGroup.userMatchAggregates[match.matchNumber-1] && match.topTeam && match.bottomTeam){ %>
                                                                <% var agg = tournamentGroup.userMatchAggregates[match.matchNumber-1] %>
                                                            
                                                               
                                                                <% if (!match.winner) { %> 
                                                                    <div class="aggregate noWin" >
                                                                <% } else if (String(match.winner) === String(match.topTeam._id)) { %>
                                                                   <div class="aggregate win" >
                                                                <% } else { %>
                                                                    <div class="aggregate loss" >
                                                                <% } %>
                                                                        <div class="teamHeader">
                                                                            <%var winScore = Math.round(agg.topWinScore * 100)/100 %>
                                                                            <%var lossScore = Math.round(agg.topLossScore * 100)/100 %>
                                                                            <h5 style="display: inline-block; "><strong><%=match.topTeam.name%></strong> (<%= agg.topTeamPickers.length %>)</h5>
                                                                            <h6 style="display: inline-block; float: right;">(
                                                                                <% if (!match.winner) { %>
                                                                                    +<%=winScore%> or <%=lossScore%>
                                                                                <% } else if (String(match.winner) === String(match.topTeam._id)) { %>
                                                                                   +<%=winScore%>
                                                                                <% } else { %>
                                                                                   <%=lossScore%>
                                                                                <% } %>
                                                                            )</h6>
                                                                        </div>
                                                                        <% if (!hidePickerNames) { %>
                                                                        <% agg.topTeamPickers.sort(function(a, b) { return (pickerRank(a) || 999) - (pickerRank(b) || 999); }); %>
                                                                        <div class="picker-names">
                                                                            <% for (var k = 0; k < agg.topTeamPickers.length; k++) { %>
                                                                                <span class="picker-name">
                                                                                    <span class="picker-rank"><%= pickerRank(agg.topTeamPickers[k]) || '' %>.</span> <%= agg.topTeamPickers[k].firstName %><% if(agg.topTeamPickers[k].comment && agg.topTeamPickers[k].comment.trim().length > 0) { %> <em class="picker-comment">- <%= agg.topTeamPickers[k].comment %></em><% } %>
                                                                                </span>
                                                                            <% } %>
                                                                        </div>
                                                                        <% } else { %>
                                                                        <p style="font-size: 12px; color: #888; margin: 4px 0;"><em>Make your picks to see who picked what!</em></p>
                                                                        <% } %>
                                                                    </div>

                                                                 <% if (!match.winner) { %>
                                                                    <div class="aggregate noWin" >
                                                                <% } else if (String(match.winner) === String(match.bottomTeam._id)) { %>
                                                                   <div class="aggregate win" >
                                                                <% } else { %>
                                                                    <div class="aggregate loss" >
                                                                <% } %>
                                                                        <div class="teamHeader">
                                                                            <%var winScore = Math.round(agg.bottomWinScore * 100)/100 %>
                                                                            <%var lossScore = Math.round(agg.bottomLossScore * 100)/100 %>
                                                                            <h5 style="display: inline-block; "><strong><%=match.bottomTeam.name%></strong> (<%= agg.bottomTeamPickers.length %>)</h5>
                                                                            <h6 style="display: inline-block; float: right;">(
                                                                                <% if (!match.winner) { %>
                                                                                    +<%=winScore%> or <%=lossScore%>
                                                                                <% } else if (String(match.winner) === String(match.bottomTeam._id)) { %>
                                                                                   +<%=winScore%>
                                                                                <% } else { %>
                                                                                   <%=lossScore%>
                                                                                <% } %>
                                                                            )</h6>
                                                                        </div>
                                                                        <% if (!hidePickerNames) { %>
                                                                        <% agg.bottomTeamPickers.sort(function(a, b) { return (pickerRank(a) || 999) - (pickerRank(b) || 999); }); %>
                                                                        <div class="picker-names">
                                                                            <% for (var k = 0; k < agg.bottomTeamPickers.length; k++) { %>
                                                                                <span class="picker-name">
                                                                                    <span class="picker-rank"><%= pickerRank(agg.bottomTeamPickers[k]) || '' %>.</span> <%= agg.bottomTeamPickers[k].firstName %><% if(agg.bottomTeamPickers[k].comment && agg.bottomTeamPickers[k].comment.trim().length > 0) { %> <em class="picker-comment">- <%= agg.bottomTeamPickers[k].comment %></em><% } %>
                                                                                </span>
                                                                            <% } %>
                                                                        </div>
                                                                        <% } else { %>
                                                                        <p style="font-size: 12px; color: #888; margin: 4px 0;"><em>Make your picks to see who picked what!</em></p>
                                                                        <% } %>
                                                                </div>
                                                                
                                                            <% } %>
                                                            
                                                        </div>
                                                    <% } %> 
                                                    <!--end looping through quarterNumMatches-->
                                                </div>
                                                <!--end oneRound-->
                                            <% } %>
                                            <!--end looping through rounds-->
                                        </div>
                                        <!--end regionRounds-->
                                    </div>
                                    <!--end blank div-->
                            </div>
                                                
                            <!--end top/bottom region-->
                    
                    <% if (quadNum % 2 === 1) { %>
                        </div>
                    <% } %>
                    <!--end left/right side-->
                <% } %>
                <!--end quadNum for loop-->
                
                
                
                <!--=========================-->
                <!--       CHAMPIONSHIP      -->
                <!--=========================-->
                <div class="bracketContents championshipSide">
                    <div class="bracketQuadrant centerRegion">
                        <h2 class="regionLocation">Final Four</h2>
                        <div>
                            <div class="regionRounds">
                                
                                <% for(var i = 4; i < tournament.rounds.length; i++) { %>
                                    <div class="oneRound">
                                        <% for(var j = 0; j < tournament.rounds[i].matches.length; j++) { %>
                                            <% var match = tournament.rounds[i].matches[j] %>
                                            <div class="match" id="match<%= match.matchNumber%>" onmouseover="nhpup.popup($('#matchAggregate<%= match.matchNumber %>').html());">
                                                <% if (i < tournament.rounds.length - 2 || quadNum % 2 === 0) { %>
                                                    <div class="team">
                                                        <div class="teamTitle">
                                                            <% if(match.topTeam !== null) { %>
                                                                <img src="<%= match.topTeam.image %>">
                                                                <span class="seed"><%=match.topTeam.seed%></span>
                                                                <span class="teamName"><%=match.topTeam.name.replace("State","St.")%></span>
                                                             <% } else { %>
                                                                &nbsp
                                                            <% } %>
                                                        </div>
                                                        <!--end team title-->
                                                    </div>
                                                    <!--end top team-->
                                                <% } %>

                                                    <div class="team">
                                                        <div class="teamTitle">
                                                            <% if(match.bottomTeam !== null) { %>
                                                                <img src="<%= match.bottomTeam.image %>">
                                                                <span class="seed"><%=match.bottomTeam.seed%></span>
                                                                <span class="teamName"><%=match.bottomTeam.name.replace("State","St.")%></span>
                                                            <% } else { %>
                                                                &nbsp
                                                            <% } %>
                                                        </div>
                                                        <!--end team title-->
                                                    </div>
                                                    <!--end bottom team-->
                                             
                                                
                                            </div>
                                            <!--end match-->
                                            
                                            <div class="aggregateBox" id="matchAggregate<%= match.matchNumber %>" style= "display: none;">
                                                <!--things get screwy here if all participants go a round without picking...but I guess if an entire group forgets to pick, no one cares enough-->
                                                <% if(tournamentGroup.userMatchAggregates[match.matchNumber-1] && match.topTeam && match.bottomTeam){ %>
                                                    <% var agg = tournamentGroup.userMatchAggregates[match.matchNumber-1] %>
                                                
                                                   
                                                    <% if (!match.winner) { %> 
                                                        <div class="aggregate noWin" >
                                                    <% } else if (String(match.winner) === String(match.topTeam._id)) { %>
                                                       <div class="aggregate win" >
                                                    <% } else { %>
                                                        <div class="aggregate loss" >
                                                    <% } %>
                                                            <div class="teamHeader">
                                                                <%var winScore = Math.round(agg.topWinScore * 10000)/10000 %>
                                                                <%var lossScore = Math.round(agg.topLossScore * 10000)/10000 %>
                                                                <h5 style="display: inline-block; "><strong><%=match.topTeam.name%></strong> (<%= agg.topTeamPickers.length %>)</h5>
                                                                <h6 style="display: inline-block; float: right;">(
                                                                    <% if (!match.winner) { %>
                                                                        +<%=winScore%> or <%=lossScore%>
                                                                    <% } else if (String(match.winner) === String(match.topTeam._id)) { %>
                                                                       +<%=winScore%>
                                                                    <% } else { %>
                                                                       <%=lossScore%>
                                                                    <% } %>
                                                                )</h6>
                                                            </div>
                                                            <% agg.topTeamPickers.sort(function(a, b) { return (pickerRank(a) || 999) - (pickerRank(b) || 999); }); %>
                                                            <div class="picker-names">
                                                                <% for (var k = 0; k < agg.topTeamPickers.length; k++) { %>
                                                                    <span class="picker-name">
                                                                        <span class="picker-rank"><%= pickerRank(agg.topTeamPickers[k]) || '' %>.</span> <%= agg.topTeamPickers[k].firstName %><% if(agg.topTeamPickers[k].comment && agg.topTeamPickers[k].comment.trim().length > 0) { %> <em class="picker-comment">- <%= agg.topTeamPickers[k].comment %></em><% } %>
                                                                    </span>
                                                                <% } %>
                                                            </div>
                                                        </div>

                                                     <% if (!match.winner) { %>
                                                        <div class="aggregate noWin" >
                                                    <% } else if (String(match.winner) === String(match.bottomTeam._id)) { %>
                                                       <div class="aggregate win" >
                                                    <% } else { %>
                                                        <div class="aggregate loss" >
                                                    <% } %>
                                                            <div class="teamHeader">
                                                                <%var winScore = Math.round(agg.bottomWinScore * 10000)/10000 %>
                                                                <%var lossScore = Math.round(agg.bottomLossScore * 10000)/10000 %>
                                                                <h5 style="display: inline-block; "><strong><%=match.bottomTeam.name%></strong> (<%= agg.bottomTeamPickers.length %>)</h5>
                                                                <h6 style="display: inline-block; float: right;">(
                                                                    <% if (!match.winner) { %>
                                                                        +<%=winScore%> or <%=lossScore%>
                                                                    <% } else if (String(match.winner) === String(match.bottomTeam._id)) { %>
                                                                       +<%=winScore%>
                                                                    <% } else { %>
                                                                       <%=lossScore%>
                                                                    <% } %>
                                                                )</h6>
                                                            </div>
                                                            <% if (!hidePickerNames) { %>
                                                            <% agg.bottomTeamPickers.sort(function(a, b) { return (pickerRank(a) || 999) - (pickerRank(b) || 999); }); %>
                                                            <div class="picker-names">
                                                                <% for (var k = 0; k < agg.bottomTeamPickers.length; k++) { %>
                                                                    <span class="picker-name">
                                                                        <span class="picker-rank"><%= pickerRank(agg.bottomTeamPickers[k]) || '' %>.</span> <%= agg.bottomTeamPickers[k].firstName %><% if(agg.bottomTeamPickers[k].comment && agg.bottomTeamPickers[k].comment.trim().length > 0) { %> <em class="picker-comment">- <%= agg.bottomTeamPickers[k].comment %></em><% } %>
                                                                    </span>
                                                                <% } %>
                                                            </div>
                                                            <% } else { %>
                                                            <p style="font-size: 12px; color: #888; margin: 4px 0;"><em>Make your picks to see who picked what!</em></p>
                                                            <% } %>
                                                    </div>
                                                    
                                                <% } %>
                                                
                                            </div>
                                            <!--end aggregateBox-->
                                        <% } %> 
                                        <!--end looping through quarterNumMatches-->
                                    </div>
                                    <!--end oneRound-->
                                <% } %>
                                <!--end looping through rounds-->
                            
                            
                                <!--champion-->
                                <div class="oneRound">
                                    <div class="match">
                                        <div class="team">
                                            <div class="teamTitle">
                                                <% if(tournament.champion) { %>
                                                    <img class="championshipImage" src="<%= tournament.champion.image %>">
                                                    <span class="seed"><%=tournament.champion.seed%></span>
                                                    <span class="teamName"><%= tournament.champion.name%>&nbsp</span>
                                                <% } else { %>
                                                    &nbsp
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                    <!--endMatch-->
                                </div>  
                                <!--endOneRound-->
                            </div>
                            <!--end region round-->
                        </div>
                        <!--end empty div-->
                    </div>
                    <!--end center region-->
                </div>
                <!--end championshipSide-->
            </div>
            <!--end col-xs-12 bracket-->
        </div>
        <!--end row-->
    </div> 
    <!--end container-fluid-->
    <% if (bonAgg) { %>
        <% if (bonAgg[4].length < 7) { %>
            <div class="championPicks" style="margin-top: -200px">
        <% } else { %>
            <div class="championPicks" >
        <% } %>
            
                <div class="bonusAggregate champAggregate">
                    <h3 class="bonusRegion">Champion Picks</h3>
                    <% if(bonAgg[4].length > 16) { %>
                        <div class="xlarge-grid">
                    <% } else if(bonAgg[4].length > 9) { %>
                        <div class="large-grid">
                    <% } else { %>
                        <div class="grid">
                    <% } %>
                            <% for (var j = 0; j < bonAgg[4].length; j++) { %>
                                <%
                                    var champMatchWinner = matchWinnerMap[String(bonAgg[4][j].matchReference)];
                                    var champTeamId = String(bonAgg[4][j].team.id._id);
                                    // Fade if: match decided and team lost, OR team eliminated from tournament
                                    var champLost = (champMatchWinner && champMatchWinner !== champTeamId) || teamLostMap[String(bonAgg[4][j].team.id)] > 0;
                                %>
                                <div class="grid-item<%= champLost ? ' lost' : '' %>">
                                    <img src="<%= bonAgg[4][j].team.image %>" onmouseover="nhpup.popup($('#bonAgg<%= (bonAgg[4][j].matchNumber + bonAgg[4][j].team.id._id)%>').html());">
                                </div>  
                                
                                <!--bonus aggregate popup-->
                                <% var bonusMatchWinner = matchWinnerMap[String(bonAgg[4][j].matchReference)] %>
                                <% var teamEliminated = teamLostMap[String(bonAgg[4][j].team.id._id)] > 0 %>
                                <div class="aggregateBox" id="bonAgg<%= (bonAgg[4][j].matchNumber + bonAgg[4][j].team.id._id)%>" style= "display: none;">
                                    <% if (bonusMatchWinner && bonusMatchWinner === String(bonAgg[4][j].team.id._id)) { %>
                                       <div class="bonAggregate win" >
                                    <% } else if (bonusMatchWinner || teamEliminated) { %>
                                        <div class="bonAggregate loss" >
                                    <% } else { %>
                                        <div class="bonAggregate noWin" >
                                    <% } %>
                                            <div class="teamHeader">
                                                <h5 style="display: inline-block; "><strong><%=bonAgg[4][j].team.name%></strong> (<%= bonAgg[4][j].teamPickers.length %>)</h5>
                                            </div>
                                            <% if (!hidePickerNames) { %>
                                            <% bonAgg[4][j].teamPickers.sort(function(a, b) { return (pickerRank(a) || 999) - (pickerRank(b) || 999); }); %>
                                            <div class="picker-names">
                                                <% for (var k = 0; k < bonAgg[4][j].teamPickers.length; k++) { %>
                                                    <span class="picker-name">
                                                        <span class="picker-rank"><%= pickerRank(bonAgg[4][j].teamPickers[k]) || '' %>.</span> <%= bonAgg[4][j].teamPickers[k].firstName %><% if(bonAgg[4][j].teamPickers[k].comment && bonAgg[4][j].teamPickers[k].comment.trim().length > 0) { %> <em class="picker-comment">- <%= bonAgg[4][j].teamPickers[k].comment %></em><% } %>
                                                    </span>
                                                <% } %>
                                            </div>
                                            <% } else { %>
                                            <p style="font-size: 12px; color: #888; margin: 4px 0;"><em>Make your picks to see who picked what!</em></p>
                                            <% } %>
                                        </div>
                                </div>
                                <!--end bonus aggregate popup-->
                            <% } %>
                        </div>
                </div>
                
            </div>
        
        <div class="spacer" style="display: block; height: <%=Math.floor(Math.sqrt(bonAgg[4].length)-2)*50%>px;"><br></div>
        <div class="bonusPicks">
            <% for(var i = 0; i < bonAgg.length - 1; i++) { %>
                <div class="bonusAggregate">
                    <h3 class="bonusRegion"><%=tournament.regions[i]%> Picks</h3>
                    <div class="grid">
    
                        <% for (var j = 0; j < bonAgg[i].length; j++) { %>
                            <%
                                var regMatchWinner = matchWinnerMap[String(bonAgg[i][j].matchReference)];
                                var regTeamId = String(bonAgg[i][j].team.id._id);
                                // Fade if: match decided and this team didn't win
                                var regLost = regMatchWinner ? regMatchWinner !== regTeamId : teamLostMap[String(bonAgg[i][j].team.id)] > 0;
                            %>
                            <div class="grid-item<%= regLost ? ' lost' : '' %>">
                                <img src="<%= bonAgg[i][j].team.image %>" onmouseover="nhpup.popup($('#bonAgg<%= (bonAgg[i][j].matchNumber + bonAgg[i][j].team.id._id)%>').html());">
                            </div>   
    
                            <!--bonus aggregate popup - make sure onmouseover is set to the div/image you want to cause this popup-->
                            <% var bonusMatchWinner = matchWinnerMap[String(bonAgg[i][j].matchReference)] %>
                            <div class="aggregateBox" id="bonAgg<%= (bonAgg[i][j].matchNumber + bonAgg[i][j].team.id._id)%>" style= "display: none;">
                                <% if (!bonusMatchWinner) { %>
                                    <div class="bonAggregate noWin" >
                                <% } else if (bonusMatchWinner === String(bonAgg[i][j].team.id._id)) { %>
                                   <div class="bonAggregate win" >
                                <% } else { %>
                                    <div class="bonAggregate loss" >
                                <% } %>
                                        <div class="teamHeader">
                                            <h5 style="display: inline-block; "><strong><%=bonAgg[i][j].team.name%></strong> (<%= bonAgg[i][j].teamPickers.length %>)</h5>
                                        </div>
                                        <% if (!hidePickerNames) { %>
                                        <% bonAgg[i][j].teamPickers.sort(function(a, b) { return (pickerRank(a) || 999) - (pickerRank(b) || 999); }); %>
                                        <div class="picker-names">
                                            <% for (var k = 0; k < bonAgg[i][j].teamPickers.length; k++) { %>
                                                <span class="picker-name">
                                                    <span class="picker-rank"><%= pickerRank(bonAgg[i][j].teamPickers[k]) || '' %>.</span> <%= bonAgg[i][j].teamPickers[k].firstName %><% if(bonAgg[i][j].teamPickers[k].comment && bonAgg[i][j].teamPickers[k].comment.trim().length > 0) { %> <em class="picker-comment">- <%= bonAgg[i][j].teamPickers[k].comment %></em><% } %>
                                                </span>
                                            <% } %>
                                        </div>
                                        <% } else { %>
                                        <p style="font-size: 12px; color: #888; margin: 4px 0;"><em>Make your picks to see who picked what!</em></p>
                                        <% } %>
                                    </div>
                            </div>
                            <!--end bonus aggregate popup-->
    
    
    
                        <% } %>
                    
                    </div>
                    
                    
                </div>
                
                
            <% } %>
        </div>
    <% } %>

    <!-- ── Mobile Bonus Picks (visible < 992px only) ── -->
    <% if (bonAgg) { %>
    <div class="mobile-bonus-picks">
        <h3><i class="fas fa-crown" style="color: #D4AF37;"></i> Champion Picks</h3>
        <% for (var j = 0; j < bonAgg[4].length; j++) { %>
            <div class="mobile-bonus-pick <%= teamLostMap[String(bonAgg[4][j].team.id)] > 0 ? 'lost' : '' %>">
                <img src="<%= bonAgg[4][j].team.image %>">
                <span class="mobile-bonus-pick-team"><%= bonAgg[4][j].team.name %></span>
                <% if (!hidePickerNames) { %>
                    <span class="mobile-bonus-pick-pickers">
                        <%= bonAgg[4][j].teamPickers.sort(function(a, b) { return (pickerRank(a) || 999) - (pickerRank(b) || 999); }).map(function(p) { return (pickerRank(p) || '') + '. ' + p.firstName; }).join(', ') %>
                    </span>
                <% } %>
            </div>
        <% } %>

        <% for (var i = 0; i < bonAgg.length - 1; i++) { %>
            <h3><i class="fas fa-basketball-ball"></i> <%= tournament.regions[i] %> Picks</h3>
            <% for (var j = 0; j < bonAgg[i].length; j++) { %>
                <div class="mobile-bonus-pick <%= teamLostMap[String(bonAgg[i][j].team.id)] > 0 ? 'lost' : '' %>">
                    <img src="<%= bonAgg[i][j].team.image %>">
                    <span class="mobile-bonus-pick-team"><%= bonAgg[i][j].team.name %></span>
                    <% if (!hidePickerNames) { %>
                        <span class="mobile-bonus-pick-pickers">
                            <%= bonAgg[i][j].teamPickers.sort(function(a, b) { return (pickerRank(a) || 999) - (pickerRank(b) || 999); }).map(function(p) { return (pickerRank(p) || '') + '. ' + p.firstName; }).join(', ') %>
                        </span>
                    <% } %>
                </div>
            <% } %>
        <% } %>
    </div>
    <% } %>

</main>
<!--end tournament-->





