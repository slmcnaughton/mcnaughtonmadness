                        <div class="large-grid">
                    <% } else { %>
                        <div class="grid">
                    <% } %>
                            <% for (var j = 0; j < bonAgg[4].length; j++) { %>
                                <%
                                    var champTeamId = bonusTeamId(bonAgg[4][j]);
                                    // Fade if: champ match decided and team didn't win, OR team eliminated
                                    var champLost = champWinnerId ? champWinnerId !== champTeamId : teamLostMap[champTeamId] > 0;
                                %>
                                <div class="grid-item<%= champLost ? ' lost' : '' %>">
                                    <img src="<%= bonAgg[4][j].team.image %>" onmouseover="nhpup.popup($('#bonAgg<%= (bonAgg[4][j].matchNumber + champTeamId)%>').html());">
                                </div>  
                                
                                <!--bonus aggregate popup-->
                                <div class="aggregateBox" id="bonAgg<%= (bonAgg[4][j].matchNumber + champTeamId)%>" style= "display: none;">
                                    <% if (champWinnerId && champWinnerId === champTeamId) { %>
                                       <div class="bonAggregate win" >
                                    <% } else if (champWinnerId || teamLostMap[champTeamId] > 0) { %>
                                        <div class="bonAggregate loss" >
                                    <% } else { %>
                                        <div class="bonAggregate noWin" >
                                    <% } %>
                                            <div class="teamHeader">
                                                <h5 style="display: inline-block; "><strong><%=bonAgg[4][j].team.name%></strong> (<%= bonAgg[4][j].teamPickers.length %>)</h5>
                                            </div>
                                            <% if (maxVisibleRound >= 1) { %>
                                            <% bonAgg[4][j].teamPickers.sort(function(a, b) { return (pickerRank(a) || 999) - (pickerRank(b) || 999); }); %>
                                            <div class="picker-names">
                                                <% for (var k = 0; k < bonAgg[4][j].teamPickers.length; k++) { %>
                                                    <span class="picker-name">
                                                        <span class="picker-rank"><%= pickerRank(bonAgg[4][j].teamPickers[k]) || '' %>.</span> <%= bonAgg[4][j].teamPickers[k].firstName %><% if(bonAgg[4][j].teamPickers[k].comment && bonAgg[4][j].teamPickers[k].comment.trim().length > 0) { %> <em class="picker-comment">- <%= bonAgg[4][j].teamPickers[k].comment %></em><% } %>
                                                    </span>
                                                <% } %>
                                            </div>
                                            <% } else { %>
                                            <p style="font-size: 12px; color: #888; margin: 4px 0;"><em>Make your picks to see who picked what!</em></p>
                                            <% } %>
                                        </div>
                                </div>
                                <!--end bonus aggregate popup-->
                            <% } %>
                        </div>
                </div>
                
            </div>
        
        <div class="spacer" style="display: block; height: <%=Math.floor(Math.sqrt(bonAgg[4].length)-2)*50%>px;"><br></div>
        <div class="bonusPicks">
            <% for(var i = 0; i < bonAgg.length - 1; i++) { %>
                <div class="bonusAggregate">
                    <h3 class="bonusRegion"><%=tournament.regions[i]%> Picks</h3>
                    <div class="grid">
    
                        <% for (var j = 0; j < bonAgg[i].length; j++) { %>
                            <%
                                var regTeamId = bonusTeamId(bonAgg[i][j]);
                                // Fade if: Elite Eight winner exists and team didn't win, OR no winner yet but team eliminated
                                var eeWinnerForRegion = regionWinnerIdByIndex[i];
                                var regLost = eeWinnerForRegion ? eeWinnerForRegion !== regTeamId : teamLostMap[regTeamId] > 0;
                            %>
                            <div class="grid-item<%= regLost ? ' lost' : '' %>">
                                <img src="<%= bonAgg[i][j].team.image %>" onmouseover="nhpup.popup($('#bonAgg<%= (bonAgg[i][j].matchNumber + regTeamId)%>').html());">
                            </div>   
    
                            <!--bonus aggregate popup - make sure onmouseover is set to the div/image you want to cause this popup-->
                            <div class="aggregateBox" id="bonAgg<%= (bonAgg[i][j].matchNumber + regTeamId)%>" style= "display: none;">
                                <% if (!eeWinnerForRegion && !teamLostMap[regTeamId]) { %>
                                    <div class="bonAggregate noWin" >
                                <% } else if (eeWinnerForRegion === regTeamId) { %>
                                   <div class="bonAggregate win" >
                                <% } else { %>
                                    <div class="bonAggregate loss" >
                                <% } %>
                                        <div class="teamHeader">
                                            <h5 style="display: inline-block; "><strong><%=bonAgg[i][j].team.name%></strong> (<%= bonAgg[i][j].teamPickers.length %>)</h5>
                                        </div>
                                        <% if (maxVisibleRound >= 1) { %>
                                        <% bonAgg[i][j].teamPickers.sort(function(a, b) { return (pickerRank(a) || 999) - (pickerRank(b) || 999); }); %>
                                        <div class="picker-names">
                                            <% for (var k = 0; k < bonAgg[i][j].teamPickers.length; k++) { %>
                                                <span class="picker-name">
                                                    <span class="picker-rank"><%= pickerRank(bonAgg[i][j].teamPickers[k]) || '' %>.</span> <%= bonAgg[i][j].teamPickers[k].firstName %><% if(bonAgg[i][j].teamPickers[k].comment && bonAgg[i][j].teamPickers[k].comment.trim().length > 0) { %> <em class="picker-comment">- <%= bonAgg[i][j].teamPickers[k].comment %></em><% } %>
                                                </span>
                                            <% } %>
                                        </div>
                                        <% } else { %>
                                        <p style="font-size: 12px; color: #888; margin: 4px 0;"><em>Make your picks to see who picked what!</em></p>
                                        <% } %>
                                    </div>
                            </div>
                            <!--end bonus aggregate popup-->
    
    
    
                        <% } %>
                    
                    </div>
                    
                    
                </div>
                
                
            <% } %>
        </div>
    <% } %>

    <!-- ── Mobile Bonus Picks (visible < 992px only) ── -->
    <% if (bonAgg) { %>
    <div class="mobile-bonus-picks">
        <h3><i class="fas fa-crown" style="color: #D4AF37;"></i> Champion Picks</h3>
        <% for (var j = 0; j < bonAgg[4].length; j++) { %>
            <%
                var mobileChampTeamId = bonusTeamId(bonAgg[4][j]);
                var mobileChampLost = champWinnerId ? champWinnerId !== mobileChampTeamId : teamLostMap[mobileChampTeamId] > 0;
            %>
            <div class="mobile-bonus-pick <%= mobileChampLost ? 'lost' : '' %>">
                <img src="<%= bonAgg[4][j].team.image %>">
                <span class="mobile-bonus-pick-team"><%= bonAgg[4][j].team.name %></span>
                <% if (maxVisibleRound >= 1) { %>
                    <span class="mobile-bonus-pick-pickers">
                        <%= bonAgg[4][j].teamPickers.sort(function(a, b) { return (pickerRank(a) || 999) - (pickerRank(b) || 999); }).map(function(p) { return (pickerRank(p) || '') + '. ' + p.firstName; }).join(', ') %>
                    </span>
                <% } %>
            </div>
        <% } %>

        <% for (var i = 0; i < bonAgg.length - 1; i++) { %>
            <h3><i class="fas fa-basketball-ball"></i> <%= tournament.regions[i] %> Picks</h3>
            <% for (var j = 0; j < bonAgg[i].length; j++) { %>
                <%
                    var mobileRegTeamId = bonusTeamId(bonAgg[i][j]);
                    var mobileEeWinner = regionWinnerIdByIndex[i];
                    var mobileRegLost = mobileEeWinner ? mobileEeWinner !== mobileRegTeamId : teamLostMap[mobileRegTeamId] > 0;
                %>
                <div class="mobile-bonus-pick <%= mobileRegLost ? 'lost' : '' %>">
                    <img src="<%= bonAgg[i][j].team.image %>">
                    <span class="mobile-bonus-pick-team"><%= bonAgg[i][j].team.name %></span>
                    <% if (maxVisibleRound >= 1) { %>
                        <span class="mobile-bonus-pick-pickers">
                            <%= bonAgg[i][j].teamPickers.sort(function(a, b) { return (pickerRank(a) || 999) - (pickerRank(b) || 999); }).map(function(p) { return (pickerRank(p) || '') + '. ' + p.firstName; }).join(', ') %>
                        </span>
                    <% } %>
                </div>
            <% } %>
        <% } %>
    </div>
    <% } %>

</main>
<!--end tournament-->





        <footer style="text-align: center; padding: 20px 0 10px; color: #999; font-size: 13px;">
            <a href="/feedback" style="color: #999;"><i class="fas fa-comment-dots"></i> Feedback & Suggestions</a>
        </footer>

        <!--Bootstrap JS CDN-->
        <script
            src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"
            integrity="sha384-Tc5IQib027qvyjSMfHjOMaLkfuWVxZxUPnCJA7l2mCWNIpG9mGCD8wGNIcPD7Txa"
            crossorigin="anonymous"></script>

        <script>
            jQuery('form').submit(function(){
                $(this).find(':submit').attr( 'disabled','disabled' );
            });

            // Mobile: convert hover popups to tap-to-show overlay
            if ('ontouchstart' in window) {
                var $overlay = $('<div id="mobilePopup" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; z-index:300; background:rgba(0,0,0,0.5); overflow-y:auto; -webkit-overflow-scrolling:touch;">' +
                    '<div style="margin:15% auto; max-width:320px; background:#fff; border-radius:8px; padding:15px; position:relative;">' +
                    '<button type="button" style="position:absolute; top:8px; right:12px; background:none; border:none; font-size:20px; cursor:pointer;">&times;</button>' +
                    '<div id="mobilePopupContent"></div>' +
                    '</div></div>');
                $('body').append($overlay);

                // Intercept match taps
                $('.match[id]').on('click', function(e) {
                    e.stopPropagation();
                    var matchNum = this.id.replace('match', '');
                    var html = $('#matchAggregate' + matchNum).html();
                    if (html) {
                        $('#mobilePopupContent').html(html);
                        $overlay.show();
                    }
                });

                // Bonus pick image taps
                $('.grid-item img[onmouseover], .gridIndividual img[onmouseover]').on('click', function(e) {
                    e.stopPropagation();
                    var attr = $(this).attr('onmouseover') || '';
                    var idMatch = attr.match(/#([^'"\)]+)/);
                    if (idMatch) {
                        var html = $(idMatch[0]).html();
                        if (html) {
                            $('#mobilePopupContent').html(html);
                            $overlay.show();
                        }
                    }
                });

                // Close on backdrop or X tap
                $overlay.on('click', function(e) {
                    if (e.target === this || $(e.target).closest('button').length) {
                        $overlay.hide();
                    }
                });
            }
        </script>
    </body>
</html>