                                                                                <% } else { %>
                                                                                    <%=missedLossTop%> or <%=missedLossBottom%>
                                                                                <% } %>
                                                                            )</h6>
                                                                        </div>
                                                                        <% if (!shouldHideForMatch(match.matchNumber)) { %>
                                                                        <% agg.missedPickers.sort(function(a, b) { return (pickerRank(a) || 999) - (pickerRank(b) || 999); }); %>
                                                                        <div class="picker-names">
                                                                            <% for (var k = 0; k < agg.missedPickers.length; k++) { %>
                                                                                <span class="picker-name">
                                                                                    <span class="picker-rank"><%= pickerRank(agg.missedPickers[k]) || '' %>.</span> <%= agg.missedPickers[k].firstName %>
                                                                                </span>
                                                                            <% } %>
                                                                        </div>
                                                                        <% } else { %>
                                                                        <p style="font-size: 12px; color: #888; margin: 4px 0;"><em>Make your picks to see who missed!</em></p>
                                                                        <% } %>
                                                                    </div>
                                                                <% } %>

                                                            <% } %>

                                                        </div>
                                                    <% } %>
                                                    <!--end looping through quarterNumMatches-->
                                                </div>
                                                <!--end oneRound-->
                                            <% } %>
                                            <!--end looping through rounds-->
                                        </div>
                                        <!--end regionRounds-->
                                    </div>
                                    <!--end blank div-->
                            </div>
                                                
                            <!--end top/bottom region-->
                    
                    <% if (quadNum % 2 === 1) { %>
                        </div>
                    <% } %>
                    <!--end left/right side-->
                <% } %>
                <!--end quadNum for loop-->
                
                
                
