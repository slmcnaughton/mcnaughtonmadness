                                                                                    <span class="picker-rank"><%= pickerRank(agg.topTeamPickers[k]) || '' %>.</span> <%= agg.topTeamPickers[k].firstName %><% if(agg.topTeamPickers[k].comment && agg.topTeamPickers[k].comment.trim().length > 0) { %> <em class="picker-comment">- <%= agg.topTeamPickers[k].comment %></em><% } %>
                                                                                </span>
                                                                            <% } %>
                                                                        </div>
                                                                        <% } else { %>
                                                                        <p style="font-size: 12px; color: #888; margin: 4px 0;"><em>Make your picks to see who picked what!</em></p>
                                                                        <% } %>
                                                                    </div>

                                                                 <% if (!match.winner) { %>
                                                                    <div class="aggregate noWin" >
                                                                <% } else if (String(match.winner) === String(match.bottomTeam._id)) { %>
                                                                   <div class="aggregate win" >
                                                                <% } else { %>
                                                                    <div class="aggregate loss" >
                                                                <% } %>
