            <a href="/feedback" style="color: #999;"><i class="fas fa-comment-dots"></i> Feedback & Suggestions</a>
        </footer>

        <!--Bootstrap JS CDN-->
        <script
            src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"
            integrity="sha384-Tc5IQib027qvyjSMfHjOMaLkfuWVxZxUPnCJA7l2mCWNIpG9mGCD8wGNIcPD7Txa"
            crossorigin="anonymous"></script>

        <script>
            jQuery('form').submit(function(){
                $(this).find(':submit').attr( 'disabled','disabled' );
            });

            // Mobile: convert hover popups to tap-to-show overlay
            if ('ontouchstart' in window) {
                var $overlay = $('<div id="mobilePopup" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; z-index:300; background:rgba(0,0,0,0.5); overflow-y:auto; -webkit-overflow-scrolling:touch;">' +
                    '<div style="margin:15% auto; max-width:320px; background:#fff; border-radius:8px; padding:15px; position:relative;">' +
                    '<button type="button" style="position:absolute; top:8px; right:12px; background:none; border:none; font-size:20px; cursor:pointer;">&times;</button>' +
                    '<div id="mobilePopupContent"></div>' +
                    '</div></div>');
                $('body').append($overlay);

                // Intercept match taps
                $('.match[id]').on('click', function(e) {
                    e.stopPropagation();
                    var matchNum = this.id.replace('match', '');
                    var html = $('#matchAggregate' + matchNum).html();
                    if (html) {
                        $('#mobilePopupContent').html(html);
                        $overlay.show();
                    }
                });

                // Bonus pick image taps
                $('.grid-item img[onmouseover], .gridIndividual img[onmouseover]').on('click', function(e) {
                    e.stopPropagation();
                    var attr = $(this).attr('onmouseover') || '';
                    var idMatch = attr.match(/#([^'"\)]+)/);
                    if (idMatch) {
                        var html = $(idMatch[0]).html();
                        if (html) {
                            $('#mobilePopupContent').html(html);
                            $overlay.show();
                        }
                    }
                });

                // Close on backdrop or X tap
                $overlay.on('click', function(e) {
                    if (e.target === this || $(e.target).closest('button').length) {
                        $overlay.hide();
                    }
                });
            }
        </script>
    </body>
</html>