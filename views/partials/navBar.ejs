</head>
    <body>
        <!--navbar-static-top-->
        <nav class="navbar navbar-inverse navbar-static-top" role="navigation"> 
            <div class="container">
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar" aria-expanded="false" aria-controls="navbar">
                        <span class="sr-only">Toggle navigation</span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>
                    
                    <a class="navbar-brand" href="/"><i class="fas fa-basketball-ball"></i><span class="hidden-sm"> McNaughton Madness</span></a>
                </div>
                <div id="navbar" class="collapse navbar-collapse">
                    <ul class="nav navbar-nav">
                        <li class="<%= typeof page !== 'undefined' && page === 'home' ? 'active' : '' %>"><a href="/home"><i class="fas fa-home"></i> Home</a></li>
                        <li class="<%= typeof page !== 'undefined' && page === 'users' ? 'active' : '' %>"><a href="/users"><i class="fas fa-users"></i> Users</a></li>
                        <% if(currentUser && (currentUser.familyTreeId || currentUser.isAdmin || (currentUser.tournamentGroups && currentUser.tournamentGroups.some(function(g) { return g.isOfficial; })))) { %>
                            <li class="<%= typeof page !== 'undefined' && page === 'familyTree' ? 'active' : '' %>"><a href="/family-tree"><i class="fas fa-tree"></i> Family Tree</a></li>
                        <% } %>
                        <li class="dropdown <%= typeof page !== 'undefined' && page === 'about' ? 'active' : '' %>">
        				  <a href="#" class="dropdown-toggle" data-toggle="dropdown"><i class="fas fa-info-circle"></i> About<b class="caret"></b></a>
        					<ul class="dropdown-menu">
        						<li><a href="/rules"><i class="fas fa-book"></i> Rules</a></li>
        						<!--<li><a href="/history">History</a></li>-->
        						<li><a href="/tournamentStandings"><i class="fas fa-trophy"></i> Previous Standings</a></li>
        						<li><a href="/feedback"><i class="fas fa-comment-dots"></i> Feedback</a></li>
        						<!--<li><a href="/website">Website Creation</a></li>-->
        					</ul>
        				</li>
        				<li class="<%= typeof page !== 'undefined' && page === 'tournaments' ? 'active' : '' %>"><a href="/tournaments/<%= new Date().getFullYear()%>"><i class="fas fa-sitemap"></i> Current Bracket</a></li>
        				<li class="dropdown <%= typeof page !== 'undefined' && page === 'tournamentGroups' ? 'active' : '' %>">
        				  <a href="#" class="dropdown-toggle" data-toggle="dropdown"><i class="fas fa-layer-group"></i> Groups<b class="caret"></b></a>
        					<ul class="dropdown-menu">
        						<li><a href="/tournamentGroups"><i class="fas fa-th-list"></i> All Groups</a></li>
        						<% if(currentUser) { %>
            						<% for (var i = 0; i < currentUser.tournamentGroups.length; i++) { %>
            						    <% if (currentUser.tournamentGroups[i].year === (new Date()).getFullYear() ) { %>
            						        <li><a href="/tournamentGroups/<%= currentUser.tournamentGroups[i].groupName %>" ><i class="fas fa-users"></i> <%= currentUser.tournamentGroups[i].groupName %></a></li>
            						    <% } %>
            						<% } %>
            					<% } %>
        						<li><a href="/tournamentGroups/new"><i class="fas fa-plus-circle"></i> Create Group</a></li>
        					</ul>
        				</li>
                    </ul>
                    <ul class="nav navbar-nav navbar-right">
                        <% if(!currentUser) { %>
                            <li class="<%= typeof page !== 'undefined' && page === 'login' ? 'active' : '' %>"><a href="/login"><i class="fas fa-sign-in-alt"></i> Login</a></li>
                            <li class="<%= typeof page !== 'undefined' && page === 'register' ? 'active' : '' %>"><a href="/register"><i class="fas fa-user-plus"></i> Sign Up</a></li>
                        <% } else { %>
                            <li class="dropdown <%= typeof page !== 'undefined' && page === 'profile' ? 'active' : '' %>">
            				  <a href="#" class="dropdown-toggle" data-toggle="dropdown">Hi <%= currentUser.firstName %>! <b class="caret"></b></a> 
            					<ul class="dropdown-menu">
            						<li><a href="/users/<%= currentUser.username %>"><i class="fas fa-user"></i> Profile</a></li>
            						<% for (var i = 0; i < currentUser.tournamentGroups.length; i++) { %>
            						    <% if (currentUser.tournamentGroups[i].year === (new Date()).getFullYear() ) { %>
            						        <li><a href="/tournamentGroups/<%= currentUser.tournamentGroups[i].groupName %>" ><i class="fas fa-users"></i> <%= currentUser.tournamentGroups[i].groupName %></a></li>
            						    <% } %>
            						<% } %>
            						<li><a href="/users/<%= currentUser.username %>/edit"><i class="fas fa-pencil-alt"></i> Edit Profile</a></li>
            						<% if(currentUser.isAdmin) { %>
            						  <li role="separator" class="divider"></li>
            						  <li><a href="/admin"><i class="fas fa-cog"></i> Admin</a></li>
            						  <li><a href="/family-tree/admin"><i class="fas fa-tree"></i> Family Tree Admin</a></li>
            						<% } %>
            						<li><a href="/logout"><i class="fas fa-sign-out-alt"></i> Log Out</a></li>
            					</ul>
            				</li>
                        <% } %>
                    </ul>
                </div>
            </div>
          
        </nav>
        <!--used for Connect-flash messages-->
        <div class="container">
            <% if(error && error.length > 0) { %>
                <div class="alert alert-danger" role="alert">
                    <%= error %>
                </div>
            <% } %>
            <% if(success && success.length > 0) { %>
                <div class="alert alert-success" role="alert">
                    <%= success %>
                </div>
            <% } %>
            <% if(info && info.length > 0) { %>
                <div class="alert alert-info" role="alert">
                    <%= info %>
                </div>
            <% } %>
        </div>
        
      
    
 
       
  